- name: epy_block_0_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self, delay=40, samp_rate=2e6):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"distance_calc\",\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32]\n        )\n\n        self.delay = delay\n\
      \        self.samp_rate = samp_rate\n        self.c = 3e8\n\n    def work(self,\
      \ input_items, output_items):\n\n        tau = self.delay / self.samp_rate\n\
      \        R = (self.c * tau) / 2\n\n        output_items[0][:] = R\n\n      \
      \  return len(output_items[0])"
    affinity: ''
    alias: ''
    comment: ''
    delay: delay
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: ('distance_calc', 'blk', [('delay', '40'), ('samp_rate', '2000000.0')],
      [('0', 'float', 1)], [('0', 'float', 1)], '', ['delay', 'samp_rate'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 340.0]
    rotation: 0
    state: enabled
