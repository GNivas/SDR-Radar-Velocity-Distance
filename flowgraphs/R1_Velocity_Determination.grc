- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport numpy as np\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, samp_rate=10000):\n        gr.sync_block.__init__(\n\
      \            self,\n            name=\"Phase Doppler Detector\",\n         \
      \   in_sig=[np.complex64],\n            out_sig=[np.float32]\n        )\n  \
      \      self.fs = samp_rate\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n\n        phase = np.unwrap(np.angle(x))\n    \
      \    dphi = np.diff(phase)\n\n        fd = np.mean(dphi) * self.fs / (2*np.pi)\n\
      \n        output_items[0][:] = abs(fd)\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: ('Phase Doppler Detector', 'blk', [('samp_rate', '10000')], [('0',
      'complex', 1)], [('0', 'float', 1)], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 296.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "from gnuradio import gr\nimport numpy as np\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self, fc=2.4e9):\n        gr.sync_block.__init__(\n      \
      \      self,\n            name=\"Speed Calculator\",\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32]\n        )\n        self.fc = fc\n       \
      \ self.c = 3e8\n\n    def work(self, input_items, output_items):\n        fd\
      \ = input_items[0]\n        v = (self.c * fd) / (2 * self.fc)\n        output_items[0][:]\
      \ = v * 3.6  # km/h\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: ''
    fc: '2400000000'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Speed Calculator', 'blk', [('fc', '2400000000.0')], [('0', 'float',
      1)], [('0', 'float', 1)], '', ['fc'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1440, 276.0]
    rotation: 0
    state: enabled
